# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# OpenAI Pricing (per 1M tokens) — обновляйте при изменении тарифов
GPT4O_INPUT_PRICE=2.50
GPT4O_OUTPUT_PRICE=10.00
GPT4OMINI_INPUT_PRICE=0.15
GPT4OMINI_OUTPUT_PRICE=0.60

# LangSmith (опционально, для tracing)
LANGSMITH_API_KEY=ls-...
LANGSMITH_PROJECT=project0-pipeline
LANGSMITH_TRACING_V2=true

# Persistence
DATABASE_URL=postgresql://user:pass@postgres:5432/pipeline_db
CHECKPOINT_DB=checkpoints.db

# Budget
DEFAULT_BUDGET_USD=5.0

# App
ENV=production
LOG_LEVEL=INFO
