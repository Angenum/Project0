{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quality Review",
  "description": "Отчёт о качестве кода от Critic",
  "type": "object",
  "required": ["overall_score", "categories", "issues", "recommendations"],
  "properties": {
    "overall_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Общая оценка качества"
    },
    "categories": {
      "type": "object",
      "description": "Оценки по категориям",
      "properties": {
        "code_quality": {"type": "number", "minimum": 0, "maximum": 10},
        "maintainability": {"type": "number", "minimum": 0, "maximum": 10},
        "performance": {"type": "number", "minimum": 0, "maximum": 10},
        "documentation": {"type": "number", "minimum": 0, "maximum": 10},
        "testing": {"type": "number", "minimum": 0, "maximum": 10}
      }
    },
    "issues": {
      "type": "array",
      "description": "Найденные проблемы",
      "items": {
        "type": "object",
        "required": ["severity", "location", "description"],
        "properties": {
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "location": {"type": "string"},
          "description": {"type": "string"},
          "suggestion": {"type": "string"}
        }
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Рекомендации по улучшению",
      "items": {"type": "string"}
    },
    "approved": {
      "type": "boolean",
      "description": "Одобрено ли качество"
    }
  },
  "additionalProperties": false
}
