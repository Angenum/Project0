{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TDD Test Plan",
  "description": "План тестов от TDD Engineer",
  "type": "object",
  "required": ["test_strategy", "test_cases", "fixtures"],
  "properties": {
    "test_strategy": {
      "type": "string",
      "description": "Общая стратегия тестирования"
    },
    "test_cases": {
      "type": "array",
      "description": "Список тест-кейсов",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "steps", "expected_result"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "type": {"type": "string", "enum": ["unit", "integration", "e2e"]},
          "component": {"type": "string"},
          "steps": {"type": "array", "items": {"type": "string"}},
          "expected_result": {"type": "string"},
          "priority": {"type": "string", "enum": ["critical", "high", "medium", "low"]}
        }
      },
      "minItems": 1
    },
    "fixtures": {
      "type": "array",
      "description": "Тестовые фикстуры и моки",
      "items": {
        "type": "object",
        "required": ["name", "purpose"],
        "properties": {
          "name": {"type": "string"},
          "purpose": {"type": "string"},
          "data": {"type": "object"}
        }
      }
    },
    "coverage_targets": {
      "type": "object",
      "description": "Целевые показатели покрытия",
      "properties": {
        "line_coverage": {"type": "number", "minimum": 0, "maximum": 100},
        "branch_coverage": {"type": "number", "minimum": 0, "maximum": 100}
      }
    }
  },
  "additionalProperties": false
}
