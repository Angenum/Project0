{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context",
  "description": "Контекст и требования от Researcher",
  "type": "object",
  "required": ["research_summary", "requirements", "constraints"],
  "properties": {
    "research_summary": {
      "type": "string",
      "description": "Общее резюме исследования"
    },
    "requirements": {
      "type": "array",
      "description": "Список требований",
      "items": {
        "type": "object",
        "required": ["id", "type", "description"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string", "enum": ["functional", "non-functional", "technical"]},
          "description": {"type": "string"},
          "priority": {"type": "string", "enum": ["must-have", "should-have", "nice-to-have"]}
        }
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "description": "Ограничения и допущения",
      "items": {"type": "string"}
    },
    "references": {
      "type": "array",
      "description": "Полезные ссылки и источники",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
